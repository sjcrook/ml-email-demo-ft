<?xml version="1.0" encoding="UTF-8"?>
  <search:options xml:lang="zxx" xmlns:search="http://marklogic.com/appservices/search" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <search:constraint name="DataHub_Collection">
    <search:collection>
      <search:facet-option>limit=25</search:facet-option>
      <search:facet-option>frequency-order</search:facet-option>
      <search:facet-option>descending</search:facet-option>
    </search:collection>
  </search:constraint>
  <search:constraint name="DataHub_entityType">
    <search:custom facet="false">
      <search:parse apply="parse" ns="http://marklogic.com/data-hub/entities/constraint/entityType" at="/data-hub/5/entities/constraint/entityType.xqy"/>
    </search:custom>
  </search:constraint>
  <search:constraint name="DataHub_hideHubArtifacts">
    <search:custom facet="false">
      <search:parse apply="parse" ns="http://marklogic.com/data-hub/entities/constraint/hideHubArtifacts" at="/data-hub/5/entities/constraint/hideHubArtifacts.xqy"/>
    </search:custom>
  </search:constraint>
  <search:constraint name="DataHub_createdByJob">
    <search:range facet="false">
      <search:field name="datahubCreatedByJob"/>
    </search:range>
  </search:constraint>
  <search:constraint name="DataHub_createdByStep">
    <search:range>
      <search:field name="datahubCreatedByStep"/>
      <search:facet-option>limit=25</search:facet-option>
      <search:facet-option>frequency-order</search:facet-option>
      <search:facet-option>descending</search:facet-option>
    </search:range>
  </search:constraint>
  <search:constraint name="DataHub_createdByJobWord">
    <search:word>
      <search:field name="datahubCreatedByJob"/>
    </search:word>
  </search:constraint>
  <search:constraint name="DataHub_ranByStepWord">
    <search:word>
      <search:field name="datahubRanBySteps"/>
    </search:word>
  </search:constraint>
  <search:constraint name="DataHub_createdOnRange">
    <search:range facet="false">
      <search:field name="datahubCreatedOn"/>
    </search:range>
  </search:constraint>
  <search:constraint name="DataHub_createdInFlowRange">
    <search:range>
      <search:field name="datahubCreatedInFlow"/>
      <search:facet-option>limit=25</search:facet-option>
      <search:facet-option>frequency-order</search:facet-option>
      <search:facet-option>descending</search:facet-option>
    </search:range>
  </search:constraint>
  <search:constraint name="DataHub_sourceName">
    <search:range>
      <search:field name="datahubSourceName"/>
      <search:facet-option>limit=25</search:facet-option>
      <search:facet-option>frequency-order</search:facet-option>
      <search:facet-option>descending</search:facet-option>
    </search:range>
  </search:constraint>
  <search:constraint name="DataHub_sourceType">
    <search:range>
      <search:field name="datahubSourceType"/>
      <search:facet-option>limit=25</search:facet-option>
      <search:facet-option>frequency-order</search:facet-option>
      <search:facet-option>descending</search:facet-option>
    </search:range>
  </search:constraint>
  <search:constraint name="DataHub_relatedTo">
    <search:custom facet="false">
      <search:parse apply="parse" ns="http://marklogic.com/data-hub/entities/constraint/relatedTo" at="/data-hub/5/entities/constraint/relatedTo.xqy"/>
    </search:custom>
  </search:constraint>
  <search:operator name="sort"/>
  <search:search-option>unfiltered</search:search-option>
  <search:return-facets>true</search:return-facets>
  <search:transform-results apply="snippet">
    <per-match-tokens>30</per-match-tokens>
    <max-matches>4</max-matches>
    <max-snippet-chars>200</max-snippet-chars>
  </search:transform-results>
</search:options>